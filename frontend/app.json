{
  "expo": {
    "name": "CampusEventsIA",
    "slug": "campuseventsia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#2563eb",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campuseventsia.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      },
      "package": "com.campuseventsia.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-sqlite"
    ]
  }
}
